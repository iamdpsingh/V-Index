[Unit]
Description=Rolewisp encrypted PostgreSQL backup
After=network-online.target

[Service]
Type=oneshot
User=rolewisp
WorkingDirectory=/srv/rolewisp
EnvironmentFile=/etc/rolewisp/backup.env
Environment=PYTHONPATH=backend
ExecStart=/srv/rolewisp/.venv/bin/python -m scripts.backup_database backup --directory /var/lib/rolewisp/backups
ExecStartPost=/srv/rolewisp/.venv/bin/python -m scripts.backup_database prune --directory /var/lib/rolewisp/backups
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rolewisp/backups
UMask=0077
