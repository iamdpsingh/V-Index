{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "includeFiles": "backend/**"
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "daemons": {
    "worker": {
      "root": ".",
      "entrypoint": "Dockerfile.worker",
      "command": [
        "/app/.venv/bin/python",
        "-m",
        "scripts.start_production_worker"
      ],
      "instances": {
        "iad1": 1
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      },
      "terminationGracePeriodSeconds": 180
    }
  }
}
