POSTGRES_PASSWORD=replace-with-url-safe-password
DATABASE_URL=postgresql+psycopg://vindex:replace-with-url-safe-password@db:5432/vindex
REDIS_URL=redis://redis:6379/0
ADMIN_TOKEN=replace-with-a-long-random-secret

# Leave origin empty to disable personal-account endpoints. HTTPS is required off loopback.
PUBLIC_WEB_ORIGIN=
ACCOUNT_REGISTRATION_ENABLED=false
# Generate privately: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESUME_ENCRYPTION_KEY=

# Optional SMTP over TLS for email verification and password recovery.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
