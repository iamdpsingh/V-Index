POSTGRES_PASSWORD=replace-with-url-safe-password
DATABASE_URL=postgresql+psycopg://vindex:replace-with-url-safe-password@db:5432/vindex
REDIS_URL=redis://redis:6379/0
ADMIN_TOKEN=replace-with-a-long-random-secret

# Leave origin empty to disable personal-account endpoints. HTTPS is required off loopback.
PUBLIC_WEB_ORIGIN=
ACCOUNT_REGISTRATION_ENABLED=false
# Generate privately: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESUME_ENCRYPTION_KEY=

# Optional SMTP over TLS for email verification and password recovery.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional OAuth provider credentials. Register matching callback URLs first.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# PostgreSQL source refresh concurrency (1–16). SQLite uses one refresh at a time.
WORKER_CONCURRENCY=4

# Identical private random value on the web server and API; never NEXT_PUBLIC_.
# Only authenticated proxy metadata affects per-client rate-limit buckets.
PROXY_SHARED_SECRET=
PUBLIC_JOB_RATE_LIMIT_ENABLED=true
ADMIN_RATE_LIMIT_ENABLED=true

# Separate 32-byte base64 key for authenticated, encrypted database backups.
# Retain outside the backup archive and separately from RESUME_ENCRYPTION_KEY.
BACKUP_ENCRYPTION_KEY=

# Hosted worker only: dedicated private Vercel Blob store, production scope.
# Store token and encryption key as Secrets. Never prefix these NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Optional one-shot operator validation; change only to request a fresh review.
RELEASE_REVIEW_ID=

# Independent external probe; read-only aggregate monitoring, never ADMIN_TOKEN.
# Match this Production Secret to the repository Actions secret of the same name.
MONITOR_TOKEN=
