            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Quality Flags"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "application_url": {
            "type": "string",
            "title": "Application Url"
          },
